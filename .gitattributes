# 统一行尾：仓库内一律 LF，仅 Windows 专属脚本用 CRLF
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.toml text eol=lf

# Windows 专属：需要 CRLF
*.bat text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf
*.spec text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.ico binary
*.jar binary
*.keystore binary
*.apk binary
*.zip binary
*.tar binary
